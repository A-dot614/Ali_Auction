{
  "name": "aliauction",
  "private": true,
  "version": "0.1.0",
  "description": "AliAuction.ca marketplace monorepo (Phase 1 foundation)",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpmWorkspaceNote": "Recursive pnpm runs (pnpm -r) target workspace packages in pnpm-workspace.yaml: apps/api, apps/web, packages/shared (3). Root orchestrates via top-level scripts and is not a recursive workspace target.",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "migrate:test": "bash scripts/test-migrations-roundtrip.sh",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.72.2"
  }
}
