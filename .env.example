# AliAuction.ca local development example
# Copy to .env and adjust values. Do not commit real secrets.

NODE_ENV=development
APP_NAME=AliAuction
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/graphql
API_PORT=4000

# PostgreSQL (source of truth)
DATABASE_URL=postgresql://aliauction:aliauction@localhost:5433/aliauction_dev

# Redis (cache, rate limits, ephemeral coordination)
REDIS_URL=redis://localhost:6380

# Auth/session (replace in real environments)
JWT_SECRET=change-me-in-local-dev-only
SESSION_COOKIE_NAME=aliauction_session

# Payments (configure per environment; use sandbox/test accounts only locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Storage/search/notifications (placeholders for later Phase 1/2 work)
S3_BUCKET=
S3_REGION=ca-central-1
ELASTICSEARCH_URL=http://localhost:9200
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Observability
LOG_LEVEL=debug
