# DEV ONLY, NOT FOR PRODUCTION.
# Local Docker Compose defaults. Replace every value before any non-local use.
# No real credentials and no payment-provider keys or names are present here.

NODE_ENV=development
APP_NAME=AliAuction
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/graphql
API_PORT=4000

# PostgreSQL: placeholders used by the db, migrate and api services.
POSTGRES_USER=aliauction
POSTGRES_PASSWORD=dev-only-password-not-for-production
POSTGRES_DB=aliauction_dev
DATABASE_URL=postgresql://aliauction:dev-only-password-not-for-production@db:5432/aliauction_dev

# Redis: local container only.
REDIS_URL=redis://redis:6379

# Auth/session placeholders.
JWT_SECRET=dev-only-jwt-secret-not-for-production
SESSION_COOKIE_NAME=aliauction_session
SESSION_TTL_DAYS=14
SESSION_ROTATE_AFTER_MINUTES=30

# Fake webhook secret and metrics token are dev-only placeholders.
FAKE_PAYMENT_WEBHOOK_SECRET=dev-only-fake-webhook-secret-not-for-production
PAYMENTS_SANDBOX_ENABLED=false
METRICS_TOKEN=dev-only-metrics-token-not-for-production
LOG_LEVEL=debug

# Feature flags: every capability stays OFF. Do not change for this build.
FEATURE_LIVE_BIDDING_ENABLED=false
FEATURE_REAL_MONEY_PAYMENTS_ENABLED=false
FEATURE_REAL_SHIPPING_RATES_ENABLED=false
FEATURE_DISPUTE_EVIDENCE_UPLOADS_ENABLED=false
FEATURE_APPROVED_DISPUTE_OUTCOMES_ENABLED=false
FEATURE_EMAIL_CHANGE_ENABLED=false
